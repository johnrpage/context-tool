<Window x:Class="ContextSketch.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ContextSketch.App.Views"
        xmlns:vm="clr-namespace:ContextSketch.App.ViewModels"
        xmlns:model="clr-namespace:ContextSketch.Core.Model;assembly=ContextSketch.Core"
        Title="{Binding WindowTitle}" Width="1200" Height="780" MinWidth="760" MinHeight="400"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="Foreground" Value="#52606D" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style x:Key="WhenSelected" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open" Command="{Binding OpenCommand}" />
            <Separator />
            <Button Content="+ Primary Actor" Command="{Binding AddElementCommand}" CommandParameter="{x:Static model:ElementType.PrimaryActor}" />
            <Button Content="+ Secondary Actor" Command="{Binding AddElementCommand}" CommandParameter="{x:Static model:ElementType.SecondaryActor}" />
            <Button Content="+ External System" Command="{Binding AddElementCommand}" CommandParameter="{x:Static model:ElementType.ExternalSystem}" />
            <Button Content="+ Storage" Command="{Binding AddElementCommand}" CommandParameter="{x:Static model:ElementType.Storage}" />
            <Separator />
            <Button Content="Auto-layout" Command="{Binding AutoLayoutCommand}" ToolTip="Arrange elements that have not been dragged" />
            <Button Content="Auto-layout all" Command="{Binding AutoLayoutAllCommand}" ToolTip="Release every pin, then arrange everything" />
            <Separator />
            <Button Content="Delete" Command="{Binding DeleteCommand}" ToolTip="Delete the selected element and its relationship (Del)" />
        </ToolBar>

        <Border DockPanel.Dock="Right" Width="270" Background="#F5F7FA" BorderBrush="#D5DAE0" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,4,12,12">

                    <!-- Nothing selected: the diagram itself -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NothingSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Diagram" Style="{StaticResource Heading}" />
                        <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DiagramTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock TextWrapping="Wrap" Foreground="#52606D" Margin="0,14,0,0"
                                   Text="Select an element or a line to edit it. Drag elements to move them; drag the background to pan and use the mouse wheel to zoom." />
                    </StackPanel>

                    <!-- Selected element -->
                    <StackPanel DataContext="{Binding SelectedElement}" Style="{StaticResource WhenSelected}">
                        <TextBlock Text="{Binding Type, StringFormat=Element ({0})}" Style="{StaticResource Heading}" />
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Technology" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Technology, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <!-- Relationship of the selection -->
                    <StackPanel DataContext="{Binding PanelRelationship}" Style="{StaticResource WhenSelected}">
                        <TextBlock Text="Relationship" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#52606D" />
                        <TextBlock Text="Label" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Technology" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Technology, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Direction" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{x:Static vm:RelationshipViewModel.DirectionOptions}" SelectedItem="{Binding Direction}" />
                        <Button Content="Swap source and target" Command="{Binding SwapEndsCommand}" Margin="0,8,0,0" Padding="6,3" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <views:DiagramCanvas />
    </DockPanel>
</Window>
