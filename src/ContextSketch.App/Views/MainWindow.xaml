<Window x:Class="ContextSketch.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ContextSketch.App.Views"
        Title="{Binding WindowTitle}" Width="1200" Height="780" MinWidth="640" MinHeight="400">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open" Command="{Binding OpenCommand}" />
        </ToolBar>
        <views:DiagramCanvas />
    </DockPanel>
</Window>
