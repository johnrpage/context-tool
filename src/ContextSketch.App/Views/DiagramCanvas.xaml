<UserControl x:Class="ContextSketch.App.Views.DiagramCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ContextSketch.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="NameText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SubText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- System: emphasised rectangle -->
        <DataTemplate x:Key="SystemTemplate" DataType="{x:Type vm:ElementViewModel}">
            <Border Background="{DynamicResource SystemFill}" BorderBrush="{DynamicResource SystemStroke}" BorderThickness="2" CornerRadius="6" Padding="10,8">
                <StackPanel VerticalAlignment="Center" TextElement.Foreground="{DynamicResource SystemText}">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" FontSize="16" MaxHeight="44" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SubText}" MaxHeight="44" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Primary actor: person glyph on a solid box -->
        <DataTemplate x:Key="PrimaryTemplate" DataType="{x:Type vm:ElementViewModel}">
            <Border Background="{DynamicResource PrimaryFill}" BorderBrush="{DynamicResource PrimaryStroke}" BorderThickness="2" CornerRadius="10" Padding="8,6">
                <StackPanel VerticalAlignment="Center" TextElement.Foreground="{DynamicResource PrimaryText}">
                    <Grid Width="26" Height="26" HorizontalAlignment="Center">
                        <Ellipse Width="11" Height="11" VerticalAlignment="Top" Fill="{DynamicResource PrimaryText}" />
                        <Path Data="M 0,26 A 13,13 0 0 1 26,26 Z" VerticalAlignment="Bottom" Fill="{DynamicResource PrimaryText}" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" MaxHeight="36" />
                    <TextBlock Text="{Binding TechnologyTag}" Style="{StaticResource SubText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Secondary actor: same glyph, light fill and dashed outline -->
        <DataTemplate x:Key="SecondaryTemplate" DataType="{x:Type vm:ElementViewModel}">
            <Grid>
                <Rectangle Fill="{DynamicResource SecondaryFill}" Stroke="{DynamicResource SecondaryStroke}" StrokeThickness="2"
                           StrokeDashArray="4 3" RadiusX="10" RadiusY="10" />
                <StackPanel VerticalAlignment="Center" Margin="8,6" TextElement.Foreground="{DynamicResource SecondaryText}">
                    <Grid Width="26" Height="26" HorizontalAlignment="Center">
                        <Ellipse Width="11" Height="11" VerticalAlignment="Top" Fill="{DynamicResource SecondaryText}" />
                        <Path Data="M 0,26 A 13,13 0 0 1 26,26 Z" VerticalAlignment="Bottom" Fill="{DynamicResource SecondaryText}" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" MaxHeight="36" />
                    <TextBlock Text="{Binding TechnologyTag}" Style="{StaticResource SubText}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- External system: plain rectangle -->
        <DataTemplate x:Key="ExternalTemplate" DataType="{x:Type vm:ElementViewModel}">
            <Border Background="{DynamicResource ExternalFill}" BorderBrush="{DynamicResource ExternalStroke}" BorderThickness="2" Padding="10,8">
                <StackPanel VerticalAlignment="Center" TextElement.Foreground="{DynamicResource ExternalText}">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" MaxHeight="40" />
                    <TextBlock Text="{Binding TechnologyTag}" Style="{StaticResource SubText}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Storage: cylinder -->
        <DataTemplate x:Key="StorageTemplate" DataType="{x:Type vm:ElementViewModel}">
            <Grid>
                <Path Fill="{DynamicResource StorageFill}" Stroke="{DynamicResource StorageStroke}" StrokeThickness="2"
                      Data="M 0,12 A 85,12 0 0 1 170,12 L 170,78 A 85,12 0 0 1 0,78 Z" />
                <Path Fill="Transparent" Stroke="{DynamicResource StorageStroke}" StrokeThickness="2"
                      Data="M 0,12 A 85,12 0 0 0 170,12" />
                <StackPanel VerticalAlignment="Center" Margin="10,18,10,6" TextElement.Foreground="{DynamicResource StorageText}">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" MaxHeight="36" />
                    <TextBlock Text="{Binding TechnologyTag}" Style="{StaticResource SubText}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ElementTemplate" DataType="{x:Type vm:ElementViewModel}">
            <Grid Width="{Binding Width}" Height="{Binding Height}">
                <ContentControl Content="{Binding}" Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource ExternalTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="System">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SystemTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="PrimaryActor">
                                    <Setter Property="ContentTemplate" Value="{StaticResource PrimaryTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="SecondaryActor">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SecondaryTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="Storage">
                                    <Setter Property="ContentTemplate" Value="{StaticResource StorageTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <Rectangle Margin="-4" RadiusX="6" RadiusY="6" Stroke="{DynamicResource Selection}" StrokeThickness="2.5" IsHitTestVisible="False"
                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RelationshipTemplate" DataType="{x:Type vm:RelationshipViewModel}">
            <Canvas>
                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{DynamicResource LineColor}" StrokeThickness="1.5" />
                <Polygon Points="{Binding EndArrow}" Fill="{DynamicResource LineColor}" />
                <Polygon Points="{Binding StartArrow}" Fill="{DynamicResource LineColor}"
                         Visibility="{Binding StartArrowVisible, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Canvas.Left="{Binding LabelLeft}" Canvas.Top="{Binding LabelTop}" Width="{Binding LabelBoxWidth}">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource SubText}" FontSize="12" Foreground="{DynamicResource LabelText}"
                               Background="{DynamicResource Background}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding TechnologyTag}" Style="{StaticResource SubText}" Foreground="{DynamicResource LineColor}"
                               Background="{DynamicResource Background}" HorizontalAlignment="Center" />
                </StackPanel>
            </Canvas>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Viewport" ClipToBounds="True" Background="{DynamicResource Background}"
          MouseWheel="OnMouseWheel" MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp"
          SizeChanged="OnSizeChanged">
        <Canvas x:Name="World" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1" Height="1">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ScaleTransform" />
                    <TranslateTransform x:Name="PanTransform" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Faint divider between the primary and secondary side -->
            <Line X1="0" X2="0" Y1="-5000" Y2="5000" Stroke="{DynamicResource Divider}" StrokeThickness="1.5" StrokeDashArray="6 6" />

            <ItemsControl ItemsSource="{Binding Relationships}" ItemTemplate="{StaticResource RelationshipTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Elements}" ItemTemplate="{StaticResource ElementTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Canvas>
    </Grid>
</UserControl>
